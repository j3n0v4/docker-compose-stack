# =============================================================================
# docker-compose-stack — media-stack environment template
#
# Copy to .env and fill in real values. The .env file is gitignored and never
# pushed. API keys are NOT stored here — they are injected from your shell
# environment (export them before running `docker compose up`), exactly as you
# would in production.
#
#   cp .env.example .env
#   docker compose --profile arr up -d
#
# All IP addresses below are RFC1918 placeholders. Replace them with your own
# host addresses in .env. No real secrets live in this file.
# =============================================================================

# --- Shared / PUID-PGID -----------------------------------------------------
PUID=3000
PGID=3001
TZ=UTC
# File permission mask applied to files created by the *arr services.
UMASK=002

# --- Host addresses (internal RFC1918 placeholders) --------------------------
# qBittorrent is a native/systemd service (not in this Compose file). Sonarr and
# radarr connect to it at this address. Set to your qBittorrent host IP or
# hostname in .env.
QBITTORRENT_HOST=10.0.0.20

# =============================================================================
# arr profile: media host
# =============================================================================

# --- Published ports ----------------------------------------------------------
SONARR_PORT=8989
RADARR_PORT=7878
LIDARR_PORT=8686
PROWLARR_PORT=9696
BAZARR_PORT=6767

# --- Image tags (pin these if you want reproducible runs) ---------------------
SONARR_IMAGE=ghcr.io/hotio/sonarr:latest
RADARR_IMAGE=ghcr.io/hotio/radarr:latest
LIDARR_IMAGE=ghcr.io/hotio/lidarr:pr-plugins
PROWLARR_IMAGE=ghcr.io/hotio/prowlarr:latest
BAZARR_IMAGE=ghcr.io/hotio/bazarr:latest
RECYCLARR_IMAGE=ghcr.io/recyclarr/recyclarr:latest

# --- Host paths ---------------------------------------------------------------
# Base directory holding all *arr per-service config dirs. Each service mounts
# ${ARR_CONFIG_BASE}/<service>/config into its container.
ARR_CONFIG_BASE=/opt/arr
# Shared scripts mounted read-only into the *arr services that need them.
ARR_SCRIPTS_DIR=/opt/arr/scripts
# Download root (NFS from the NAS). *arr services reach it here.
DOWNLOADS_DIR=/mnt/downloads
# Media root (NFS from the NAS). Subpaths: tv, movies, anime, cartoons, music,
# audiobooks. Used as ${MEDIA_DIR}/<type>.
MEDIA_DIR=/mnt/media
# Host log dir mounted into sonarr/radarr/bazarr for media-cleanup logs.
MEDIA_LOG_DIR=/var/log/media-cleanup

# =============================================================================
# music profile: music host
# =============================================================================

# --- music-assistant -----------------------------------------------------------
MUSIC_ASSISTANT_IMAGE=ghcr.io/music-assistant/server:latest
MA_DATA_DIR=/opt/music-assistant/data

# --- audiobookshelf ------------------------------------------------------------
AUDIOBOOKSHELF_PORT=13378
AUDIOBOOKSHELF_IMAGE=ghcr.io/advplyr/audiobookshelf:latest
ABS_CONFIG_DIR=/opt/audiobookshelf/config
ABS_METADATA_DIR=/opt/audiobookshelf/metadata

# =============================================================================
# jellyfin profile: media server
# =============================================================================

# --- Published ports ----------------------------------------------------------
JELLYFIN_PORT=8096
JELLYFIN_HTTPS_PORT=8920

# --- Image tag (pin this if you want reproducible runs) ------------------------
JELLYFIN_IMAGE=jellyfin/jellyfin:latest

# --- Host paths ---------------------------------------------------------------
# Config and cache dirs for the Jellyfin server.
JELLYFIN_CONFIG_DIR=/opt/jellyfin/config
JELLYFIN_CACHE_DIR=/opt/jellyfin/cache

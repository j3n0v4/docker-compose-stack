# =============================================================================
# docker-compose-stack — search-engine environment template
#
# Copy to .env and fill in real values. The .env file is gitignored and never
# pushed. Secrets (SEARXNG_SECRET) are NOT stored in this template — generate
# your own and put them in .env.
#
#   cp .env.example .env
#   docker compose --profile core up -d
#
# No real secrets live in this file.
# =============================================================================

# --- Shared ------------------------------------------------------------------
TZ=UTC

# =============================================================================
# core profile: searxng + valkey (the only profile)
# =============================================================================

# --- Image tags (pin these if you want reproducible runs) ---------------------
SEARXNG_IMAGE=searxng/searxng:latest
VALKEY_IMAGE=valkey/valkey:9-alpine

# --- Published port (loopback-only by default) --------------------------------
# Bind address is hardcoded to 127.0.0.1 in docker-compose.yml for a private
# instance. Change the bind there if you intentionally want LAN access.
SEARXNG_PORT=8080

# --- SearXNG configuration ----------------------------------------------------
# Public base URL. For a loopback-only instance use http://127.0.0.1:8080/.
# If you expose via a reverse proxy, use your real hostname
# (e.g. https://search.example.com/).
SEARXNG_BASE_URL=http://127.0.0.1:8080/
# MANDATORY — the instance will not boot without a secret_key. Generate one:
#   openssl rand -hex 32
SEARXNG_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
# Host dir holding settings.yml and limiter.toml (see searxng/README.md for
# requirements). Both files are mounted read-only into the container.
SEARXNG_CONFIG_DIR=/opt/searxng
# SEARXNG_VALKEY_URL is the official env var name (SearXNG migrated from
# SEARXNG_REDIS_URL). It points at the valkey service on the internal network.
SEARXNG_VALKEY_URL=valkey://valkey:6379/0

# =============================================================================
# What's pre-filled in settings.yml vs env-only
# =============================================================================
# The following are configured in searxng/settings.yml (committed template) and
# do NOT need to be set here:
#   - server.limiter, public_instance, image_proxy, method, http headers
#   - search.formats, ui.query_in_title, general.enable_metrics
#   - valkey.url, outgoing.useragent_suffix
#   - disabled engines (google, yandex, yahoo, bing)
#   - limiter.toml (botdetection, trusted proxies, pass_searxng_org)
#
# Env-only values (must be set here):
#   - SEARXNG_IMAGE, VALKEY_IMAGE (image tags)
#   - SEARXNG_PORT, SEARXNG_BASE_URL, SEARXNG_SECRET, SEARXNG_CONFIG_DIR
#   - SEARXNG_VALKEY_URL

# =============================================================================
# docker-compose-stack — frigate NVR environment template
#
# Copy to .env and fill in real values. The .env file is gitignored and never
# pushed. Secrets (FRIGATE_RTSP_PASSWORD) are stored here, not in the Compose
# file or committed config.
#
#   cp .env.example .env
#   docker compose --profile nvr up -d
#
# All IP addresses below are RFC1918 placeholders. Replace them with your own
# host addresses in .env. No real secrets live in this file.
# =============================================================================

# --- Shared ------------------------------------------------------------------
TZ=UTC

# =============================================================================
# nvr profile: Frigate NVR
# =============================================================================

# --- Image tag (pin this if you want reproducible runs) -----------------------
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:stable

# --- Bind address (127.0.0.1 by default for a private instance) ---------------
# Change to 0.0.0.0 if you need LAN access without a reverse proxy.
FRIGATE_HOST=127.0.0.1

# --- Secrets (MUST be set before first run) -----------------------------------
# RTSP password for camera streams. Generate a strong one:
#   openssl rand -hex 24
FRIGATE_RTSP_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# --- Host paths ---------------------------------------------------------------
# Base directory holding the Frigate config directory. The Compose file mounts
# ${FRIGATE_CONFIG_DIR}/config.yml read-only into the container.
FRIGATE_CONFIG_DIR=/opt/frigate
# Database directory (event storage, etc.).
FRIGATE_DB_DIR=/opt/frigate/db
# Media storage (recordings, snapshots).
FRIGATE_MEDIA_DIR=/opt/frigate/media
# Optional clips directory. Set to the same path as FRIGATE_MEDIA_DIR if you
# do not want a separate clips volume.
FRIGATE_CLIPS_DIR=/opt/frigate/clips